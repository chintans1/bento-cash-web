# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth is the current Bento Cash identity provider.
# Create a Web application credential and add this redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional separate key for Lunch Money credential encryption. If omitted,
# BETTER_AUTH_SECRET is used. Changing this key requires re-encrypting credentials.
BENTO_CREDENTIAL_ENCRYPTION_KEY=
