# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Lunch Money OAuth confidential web client. Add both callback URLs in the
# Developer Portal: http://localhost:3000/api/auth/callback/lunch_money and
# https://bento-cash.chintan-cf.work/api/auth/callback/lunch_money.
LUNCH_MONEY_CLIENT_ID=
LUNCH_MONEY_CLIENT_SECRET=
# OAuth preview issuer. Remove this override when production OAuth is live.
LUNCH_MONEY_OAUTH_ISSUER=https://api-alpha.lunchmoney.dev

# Optional separate key for Lunch Money credential encryption. If omitted,
# BETTER_AUTH_SECRET is used. Changing this key requires re-encrypting credentials.
BENTO_CREDENTIAL_ENCRYPTION_KEY=
