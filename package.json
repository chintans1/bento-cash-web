{
  "name": "bento-cash-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:bootstrap": "node scripts/deploy-cloudflare.mjs --bootstrap",
    "deploy:check": "node scripts/deploy-cloudflare.mjs --bootstrap --dry-run",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vinext typegen && cf workers types && tsc --noEmit",
    "db:generate": "auth generate --config scripts/auth-schema.config.ts --output migrations/001_better_auth.sql --yes",
    "db:migrate": "node scripts/migrate-do.mjs",
    "prepare": "husky",
    "deploy:database": "cf deploy --prebuilt --mode production --worker bento-cash-web-database"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@lunch-money/lunch-money-js-v2": "^2.11.0",
    "@vinext/cloudflare": "^1.0.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-server-dom-webpack": "^19.2.6",
    "recharts": "^3.8.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@eslint/js": "^9.39.4",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "auth": "^1.7.4",
    "cf": "1.0.0-beta.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "8.5.10",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.0",
    "vitest": "^4.1.5"
  }
}
